{
  "name": "hooktrack-studio-build",
  "private": true,
  "version": "1.0.0",
  "description": "One-off bundle step for the Shotstack Studio editor page only. Not part of HookTrack's own runtime - the rest of the app stays plain <script> tags with no build step.",
  "scripts": {
    "build": "esbuild src/entry.js --bundle --format=iife --global-name=HookTrackStudioBundle --outfile=../static/studio-bundle.js --minify",
    "build:transcriber": "esbuild src/transcriber-worker.js --bundle --platform=browser --format=esm --outfile=../static/studio-transcriber-worker.js --minify"
  },
  "dependencies": {
    "@shotstack/shotstack-studio": "2.31.1",
    "mediabunny": "^1.66.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
